// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "lsp": {
        "vtsls": {
            "settings": {
                "typescript": {
                    "updateImportsOnFileMove": {
                        "enabled": "always",
                    },
                },
                "javascript": {
                    "updateImportsOnFileMove": {
                        "enabled": "always",
                    },
                },
            },
            "enable_lsp_tasks": true,
        },
    },
    // Extensões instaladas automaticamente (tema e ícones usados abaixo)
    "auto_install_extensions": {
        "vesper-blur": true,
        "material-icon-theme": true,
        "html": true,
    },
    "inline_code_actions": false,
    "cli_default_open_behavior": "existing_window",
    "ui_font_family": "Noto Sans",
    "collaboration_panel": {
        "button": false,
    },
    "git_panel": {
        "scrollbar": {
            "show": "never",
        },
    },
    "toolbar": {
        "breadcrumbs": false,
        "agent_review": false,
        "code_actions": false,
        "quick_actions": false,
        "selections_menu": false,
    },
    "disable_ai": true,
    "agent": {
        "button": false,
        "sidebar_side": "right",
        "favorite_models": [],
        "model_parameters": [],
    },
    "title_bar": {
        "show_branch_status_icon": false,
        "show_branch_name": false,
        "show_menus": false,
        "show_onboarding_banner": false,
        "show_project_items": false,
        "show_sign_in": false,
        "show_user_menu": false,
        "show_user_picture": false,
        "button_layout": null,
    },
    "tabs": {
        "file_icons": true,
        "close_position": "right",
    },
    "icon_theme": {
        "mode": "dark",
        "light": "Monospace Icon Theme - Light",
        "dark": "Material Icon Theme",
    },
    "telemetry": {
        "diagnostics": true,
        "metrics": false,
    },
    "terminal": {
        "button": false,
        "font_size": 16.0,
        "font_family": "JetBrainsMonoNL Nerd Font Mono",
    },
    "project_panel": {
        "hide_hidden": false,
        "hide_root": false,
        "sticky_scroll": false,
        "scrollbar": {
            "horizontal_scroll": true,
            "show": "never",
        },
        "indent_size": 20.0,
        "button": false,
        "auto_fold_dirs": false,
        "sort_mode": "directories_first",
    },
    "base_keymap": "VSCode",
    "status_bar": {
        "active_language_button": false,
        "experimental.show": false,
    },
    "tab_bar": {
        "show_pinned_tabs_in_separate_row": true,
        "show_nav_history_buttons": false,
        "show": true,
        "show_tab_bar_buttons": false,
    },
    "show_signature_help_after_edits": false,
    "auto_signature_help": false,
    "sticky_scroll": {
        "enabled": false,
    },
    "minimap": {
        "show": "never",
    },
    "current_line_highlight": "gutter",
    "autosave": {
        "after_delay": {
            "milliseconds": 300,
        },
    },
    "buffer_font_family": "JetBrainsMonoNL Nerd Font Mono",
    "file_types": {
        "json": [".prettierrc"],
        "dotenv": [".env.*", ".dev.vars"],
        "css": ["*.css"],
    },
    "linked_edits": true,
    "semantic_tokens": "off",
    "wrap_guides": [80, 120],
    "ui_font_size": 18,
    "buffer_font_size": 16,
    "buffer_font_weight": 450,
    "buffer_line_height": "comfortable",
    "theme": {
        "mode": "dark",
        "light": "Gruvbox Light",
        "dark": "Vesper Blur",
    },
    "tab_size": 4,
}
